  printf '%s recovery-start rc=%s oc-live=%s pi-live=%s oc-submitted=%s pi-submitted=%s tab=%s oc-root=%s pi-root=%s\n' \
    "$(stamp)" "$rc" "$oc_live" "$pi_live" "$oc_submitted" "$pi_submitted" "$tab_id" "$oc_root" "$pi_root" >&2
  assert_endpoint >&2
  if test -n "$baseline_socket" && test "$(assert_endpoint 2>/dev/null)" = "$baseline_socket"; then generation_once "$baseline_socket" >&2; fi
  peer_inventory >&2
  observe_media recovery >&2
  for current in "$oc_pane" "$pi_pane"; do
    test -n "$current" || continue
    process_info "$current" >&2
    herdr pane read "$current" --source visible --format text >&2
    herdr pane read "$current" --source visible --format ansi >&2
  done
  if test "$pi_live" -eq 1; then
    info="$(process_info "$pi_pane")"
    herdr pane run "$pi_pane" '/quit' >/dev/null
    wait_shell "$pi_pane" "$pi_shell_pid" >/dev/null && assert_recorded_pids_gone "$info" && test -z "$(process_group "$pi_pgid")" && pi_live=0
  fi
  if test "$oc_live" -eq 1; then
    info="$(process_info "$oc_pane")"
    if select_palette "$oc_pane" 'Exit' 'System' 'Exit the app'; then
      herdr pane send-keys "$oc_pane" enter >/dev/null
      wait_shell "$oc_pane" "$oc_shell_pid" >/dev/null && assert_recorded_pids_gone "$info" && test -z "$(process_group "$oc_pgid")" && oc_live=0
