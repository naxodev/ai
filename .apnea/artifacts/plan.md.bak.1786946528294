    const ansi=process.env.PALETTE_ANSI??"", group=process.env.PALETTE_GROUP??"", title=process.env.PALETTE_TITLE??""
    const strip=(s)=>s.replace(/\x1b\[[0-?]*[ -\/]*[@-~]/g,"")
    const boldAt=(line)=>{
      const index=line.indexOf(title); if(index<0)return false
      let bold=false
      for(const match of line.slice(0,index).matchAll(/\x1b\[([0-9;]*)m/g)){
        const values=match[1]===""?[0]:match[1].split(";").map(Number)
        for(const value of values){if(value===0||value===22)bold=false;if(value===1)bold=true}
      }
      return bold
    }
    const rows=ansi.split("\n").filter(line=>{const plain=strip(line);return plain.includes(group)&&plain.includes(title)})
    const selected=rows.filter(boldAt)
    if(selected.length!==1)throw new Error(`expected one bold ${group} / ${title} row; got ${selected.length}`)
    console.log(strip(selected[0]).trim())
  ' || return 1
  printf '%s selected=%s/%s\n%s\n' "$(stamp)" "$group" "$title" "$UI_ANSI"
}

validate_root() {
  local root="$1" prefix="$2" owner parent processes
  test -d "$root" || return 1
  test ! -L "$root" || return 1
  owner="$(stat -f '%u' "$root")" || return 1
  test "$owner" = "$(id -u)" || return 1
  parent="$(realpath "$(dirname "$root")")" || return 1
  test "$parent" = "$tmp_base" || return 1
  case "$(basename "$root")" in "$prefix".*) ;; *) return 1 ;; esac
  processes="$(ps -axww -o command=)" || return 1
  ! grep -Fq -- "$root" <<<"$processes" || return 1
  printf '%s validated-root=%s\n' "$(stamp)" "$root"
}
delete_root() {
  local root="$1" prefix="$2"
  validate_root "$root" "$prefix" || return 1
  find "$root" -depth -delete || return 1
  test ! -e "$root" || return 1
  printf '%s deleted-owned-root=%s\n' "$(stamp)" "$root"
}

