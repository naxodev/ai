media_snapshot() {
  media-control get --no-artwork | jq -Sce '
    {bundleIdentifier,processIdentifier,contentItemIdentifier,title,artist,album,duration,playing,playbackRate}
    | select((.bundleIdentifier|type=="string" and length>0)
      and (.processIdentifier|type=="number")
      and (.contentItemIdentifier|type=="string" and length>0)
      and (.title|type=="string" and length>0)
      and (.artist|type=="string" and length>0)
      and (.playing|type=="boolean"))'
}

same_identity() {
  test "$(jq -r '[.bundleIdentifier,.processIdentifier,.contentItemIdentifier,.title,.artist]|@tsv' <<<"$1")" = \
       "$(jq -r '[.bundleIdentifier,.processIdentifier,.contentItemIdentifier,.title,.artist]|@tsv' <<<"$2")"
}

wait_media_state() {
  local identity="$1" wanted="$2" deadline=$((SECONDS+15)) current
  while test "$SECONDS" -lt "$deadline"; do
    if current="$(media_snapshot 2>/dev/null)" && same_identity "$identity" "$current" &&
       test "$(jq -r .playing <<<"$current")" = "$wanted"; then
      printf '%s\n' "$current"; return 0
    fi
    sleep 0.25
  done
  return 1
}

restore_candidate_if_needed() {
  local original="$1" current desired restored command_rc=0
  desired="$(jq -r .playing <<<"$original")"
  current="$(media_snapshot 2>/dev/null || true)"
  if test "$current" = "$original"; then return 0; fi
  same_identity "$original" "$current" || return 1
  checkpoint pre-rejected-candidate-explicit-restore 0 0
  if test "$desired" = true; then media-control play || command_rc=$?; else media-control pause || command_rc=$?; fi
  restored="$(wait_media_state "$original" "$desired" || true)"
  checkpoint post-rejected-candidate-explicit-restore 0 0
  test "$command_rc" -eq 0
  test "$restored" = "$original"
}

prove_media_candidate() {
  local note="$1" original playing opposite changed restored first_rc=0 second_rc=0
  original="$(media_snapshot)" || return 1
  playing="$(jq -r .playing <<<"$original")"
  if test "$playing" = true; then opposite=false; else opposite=true; fi
  printf 'candidate-source-note=%s candidate-original=%s\n' "$note" "$original"

  checkpoint pre-media-control-proof-toggle 0 0
  media-control toggle-play-pause || first_rc=$?
  changed="$(wait_media_state "$original" "$opposite" || true)"
  checkpoint post-media-control-proof-toggle 0 0
  if test "$first_rc" -ne 0 || test -z "$changed"; then
    if ! restore_candidate_if_needed "$original"; then
      printf 'candidate-restoration-blocked first_rc=%s observed=%s\n' "$first_rc" "$changed" >&2
      return 2
    fi
    printf 'candidate-rejected first_rc=%s observed=%s\n' "$first_rc" "$changed"
    return 1
  fi

  checkpoint pre-media-control-proof-restore 0 0
  media-control toggle-play-pause || second_rc=$?
  restored="$(wait_media_state "$original" "$playing" || true)"
  checkpoint post-media-control-proof-restore 0 0
  if test "$second_rc" -ne 0 || test "$restored" != "$original"; then
    if ! restore_candidate_if_needed "$original"; then
      printf 'candidate-restoration-blocked second_rc=%s observed=%s\n' "$second_rc" "$restored" >&2
      return 2
    fi
    printf 'candidate-rejected second_rc=%s observed=%s\n' "$second_rc" "$restored"
    return 1
  fi

  printf 'media-control-proof source=%s original=%s opposite=%s restored=%s\n' \
    "$note" "$original" "$changed" "$restored"
  chosen_original="$original"
  chosen_playing="$playing"
  chosen_opposite="$opposite"
  chosen_source_note="$note"
}

