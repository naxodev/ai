  oc="$(rows_for_pgid "$current" "$oc_pgid")"
  pi="$(rows_for_pgid "$current" "$pi_pgid")"
  test "$(row_count "$oc")" -eq "$want_oc"
  test "$(row_count "$pi")" -eq "$want_pi"
  test "$(row_count "$current")" -eq "$((baseline_peer_count + want_oc + want_pi))"
  printf '%s\n' "$current"
