select_oc_palette_action() {
  local pane="$1" query="$2" group="$3" title="$4" hint="$5" text ansi selected count
  herdr pane send-keys "$pane" ctrl+p >/dev/null
  herdr pane wait-output "$pane" --match 'Commands' --source visible --timeout 10000 >/dev/null
  herdr pane send-text "$pane" "$query" >/dev/null
  sleep 0.4
  text="$(read_ui "$pane" text)"; ansi="$(read_ui "$pane" ansi)"
  selected="$(printf '%s\n' "$ansi" | grep -F -- "$title" | grep -F -- "$group" | grep -F -- "$hint" || true)"
  count="$(printf '%s\n' "$selected" | grep -c . || true)"
  test "$count" -eq 1
  # The sole exact result row must carry an ANSI selection background/reverse attribute.
  printf '%s\n' "$selected" | LC_ALL=C grep -Eq $'\033\\[(7|4[0-9]|10[0-7]|48;[0-9;]+)m'
  grep -Fq -- "$query" <<<"$text"
  printf 'selected-palette-action query=%s group=%s title=%s hint=%s\n%s\n' \
    "$query" "$group" "$title" "$hint" "$ansi"
}

cleanup_owned_root() {
