assert_endpoint() {
  test "$(ps -p "$daemon_pid" -o command=)" = "$daemon_command"
  test -S "$socket"
  test "$(stat -f '%u:%Lp' "$socket")" = "$(id -u):600"
  test "$(stat -f '%u:%Lp' "$(dirname "$socket")")" = "$(id -u):700"
  lsof -n -a -p "$daemon_pid" "$socket" >/dev/null
  stat -f '%d:%i:%u:%Lp' "$socket"
}

direct_generation() {
  local before observed after
  before="$(assert_endpoint)"
  observed="$(MUSIC_SESSION_SOCKET="$socket" bun -e '
    import { baselineCapabilities, createMusicSessionClient } from "./packages/music-core/index.ts"
    const socketPath = process.env.MUSIC_SESSION_SOCKET
    if (!socketPath) throw new Error("missing explicit socket")
    const client = await createMusicSessionClient({
      socketPath,
      clientId: `final-cert-${process.pid}`,
      hostKind: "test",
      capabilities: [...baselineCapabilities],
    })
    try { console.log(client.daemonInstanceId) } finally { client.dispose() }
  ')"
  after="$(assert_endpoint)"
  test "$after" = "$before"
  test -n "$observed"
  printf '%s\n' "$observed"
}

peer_inventory_once() {
  local tokens all token pid fd command
  tokens="$(lsof -n -a -U -p "$daemon_pid" | awk -v path="$socket" '$NF == path { print $6 }' | LC_ALL=C sort -u)"
  test -n "$tokens"
  all="$(lsof -n -U)"
  for token in $tokens; do
    while read -r pid fd; do
      test -n "$pid" || continue
      command="$(ps -p "$pid" -o command=)"
      test -n "$command"
      printf '%s\t%s\t%s\t%s\n' "$pid" "$fd" "->$token" "$command"
    done < <(printf '%s\n' "$all" | awk -v target="->$token" -v daemon="$daemon_pid" \
      '$NF == target && $2 != daemon { print $2, $4 }')
  done | LC_ALL=C sort
}

stable_peers() {
  local first second
  first="$(peer_inventory_once)"; sleep 0.2; second="$(peer_inventory_once)"
  test "$second" = "$first"
  printf '%s\n' "$first"
}

row_count() {
  if test -z "$1"; then printf '0\n'; else printf '%s\n' "$1" | awk 'END {print NR}'; fi
}

rows_for_pgid() {
  local inventory="$1" wanted="$2" pid fd endpoint command pgid
  test "$wanted" != -1 || return 0
  while IFS=$'\t' read -r pid fd endpoint command; do
    test -n "$pid" || continue
    pgid="$(ps -p "$pid" -o pgid= | tr -d ' ')"
    test "$pgid" = "$wanted" && printf '%s\t%s\t%s\t%s\n' "$pid" "$fd" "$endpoint" "$command"
  done <<<"$inventory"
}

assert_peer_shape() {
  local want_oc="$1" want_pi="$2" current row oc pi
