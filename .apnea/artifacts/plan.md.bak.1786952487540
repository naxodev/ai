      const digest = createHash("sha256").update(await readFile(resolve(root, child))).digest("hex")
      rows.push(`f\t${mode}\t${digest}\t${child}`)
    } else if (stat.isSymbolicLink()) {
      rows.push(`l\t${mode}\t${await readlink(resolve(root, child))}\t${child}`)
    } else {
      rows.push(`o\t${mode}\t${child}`)
    }
  }
}
await walk()
