original_raw="$(raw_media)"
original_raw_id="$(jq -c 'if has("contentItemIdentifier") then .contentItemIdentifier else null end' <<<"$original_raw")"
printf '%s media=original-raw raw-contentItemIdentifier=%s raw=%s\n' "$(stamp)" "$original_raw_id" "$original_raw"
original_state="$(canonical_state <<<"$original_raw")"
test "$(jq -r '.bundleIdentifier' <<<"$original_state")" = 'org.videolan.vlc'
selected_command="$(process_command_for "$original_state")"
test -n "$selected_command"
printf '%s selected-vlc-process=%s full-command=%s canonical=%s raw-contentItemIdentifier=%s\n' \
  "$(stamp)" "$(jq -r '.processIdentifier' <<<"$original_state")" "$selected_command" "$original_state" "$original_raw_id"
original_identity="$(identity_of "$original_state")"
original_playing="$(jq -r '.playing' <<<"$original_state")"
if test "$original_playing" = true; then opposite_playing=false; restore_action=play; else opposite_playing=true; restore_action=pause; fi
assert_stable_state "$original_state" direct-baseline
checkpoint pre-direct-toggle 0 0
media-control toggle-play-pause
checkpoint post-direct-toggle 0 0
direct_opposite="$(wait_media "$opposite_playing" direct-opposite)"
test "$(identity_of "$direct_opposite")" = "$original_identity"
checkpoint pre-direct-restore 0 0
media-control "$restore_action"
checkpoint post-direct-restore 0 0
direct_restored="$(wait_media "$original_playing" direct-restored)"
test "$direct_restored" = "$original_state"
assert_stable_state "$original_state" direct-restored-stable

# Fresh exact host roots and configs.
oc_root="$(mktemp -d "$tmp_base/opencode-next-17386.XXXXXX")"
cat >"$oc_root/package.json" <<'JSON'
{"private":true,"dependencies":{"@opencode-ai/cli":"0.0.0-next-17386"},"trustedDependencies":["@opencode-ai/cli"]}
JSON
(cd "$oc_root" && bun install --silent)
oc_binary="$(realpath "$oc_root/node_modules/.bin/opencode2")"
case "$oc_binary" in "$oc_root"/*) ;; *) false ;; esac
test "$($oc_binary --version)" = 'opencode2 v0.0.0-next-17386'
mkdir -p "$oc_root/config" "$oc_root/xdg/config" "$oc_root/xdg/state" "$oc_root/xdg/data" "$oc_root/xdg/cache"
printf '%s\n' '{"plugins":["/Users/nachovazquez/work/1-projects/naxodev/ai/packages/opencode-music-player/index.tsx"]}' >"$oc_root/config/cli.json"
test "$(jq -c . "$oc_root/config/cli.json")" = '{"plugins":["/Users/nachovazquez/work/1-projects/naxodev/ai/packages/opencode-music-player/index.tsx"]}'

pi_root="$(mktemp -d "$tmp_base/pi-vlc-cert.XXXXXX")"
cat >"$pi_root/package.json" <<'JSON'
{"private":true,"dependencies":{"@earendil-works/pi-coding-agent":"0.84.0","@earendil-works/pi-tui":"0.84.0"}}
JSON
(cd "$pi_root" && bun install --ignore-scripts --silent)
pi_binary="$(realpath "$pi_root/node_modules/.bin/pi")"
case "$pi_binary" in "$pi_root"/*) ;; *) false ;; esac
test "$($pi_binary --version)" = '0.84.0'
printf '%s\n' '{"packages":["/Users/nachovazquez/work/1-projects/naxodev/ai/packages/pi-music-dock"]}' >"$pi_root/settings.json"
test "$(jq -c . "$pi_root/settings.json")" = '{"packages":["/Users/nachovazquez/work/1-projects/naxodev/ai/packages/pi-music-dock"]}'

# Returned regular tab and panes.
tab_json="$(herdr tab create --workspace "$workspace_id" --cwd "$repo" --label 'final-vlc-cert' --no-focus)"
tab_id="$(jq -er '.result.tab.tab_id' <<<"$tab_json")"
oc_pane="$(jq -er '.result.root_pane.pane_id' <<<"$tab_json")"
split_json="$(herdr pane split "$oc_pane" --direction right --ratio 0.5 --cwd "$repo" --no-focus)"
pi_pane="$(jq -er '.result.pane | .pane_id' <<<"$split_json")"
printf '%s topology-tab-create=%s parsed-tab=%s parsed-root-pane=%s split=%s parsed-split-pane=%s\n' \
  "$(stamp)" "$tab_json" "$tab_id" "$oc_pane" "$split_json" "$pi_pane"
oc_shell_pid="$(process_info "$oc_pane" | jq -er '.result.process_info.shell_pid')"
pi_shell_pid="$(process_info "$pi_pane" | jq -er '.result.process_info.shell_pid')"
owned_sorted="$(printf '%s\n%s\n' "$oc_pane" "$pi_pane" | LC_ALL=C sort)"
test "$(herdr pane list --workspace "$workspace_id" | jq -r --arg tab "$tab_id" '.result.panes[]|select(.tab_id==$tab)|.pane_id' | LC_ALL=C sort)" = "$owned_sorted"

# Exact OpenCode launch.
oc_command="env XDG_CONFIG_HOME=$(quote "$oc_root/xdg/config") XDG_STATE_HOME=$(quote "$oc_root/xdg/state") XDG_DATA_HOME=$(quote "$oc_root/xdg/data") XDG_CACHE_HOME=$(quote "$oc_root/xdg/cache") OPENCODE_CONFIG_DIR=$(quote "$oc_root/config") OPENCODE_CONFIG_PROJECT_DISABLE=1 OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_MODELS_FETCH=1 $(quote "$oc_binary") --standalone --log-level error $(quote "$repo")"
checkpoint pre-opencode-launch 0 0
oc_submitted=1
herdr pane run "$oc_pane" "$oc_command" >/dev/null
oc_info="$(wait_non_shell_group "$oc_pane" "$oc_shell_pid")"
oc_pgid="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$oc_info")"
oc_host_pid="$(host_pid_from_info "$oc_info")"
test "$oc_host_pid" = "$oc_pgid"
test -n "$(foreground_commands "$oc_info")"
test -n "$(process_group "$oc_pgid")"
# Classification is complete and recovery owns the group before the independent peer poll begins.
oc_live=1
oc_peer_row="$(wait_peer_for_exact_host_pid opencode "$oc_host_pid")"
checkpoint post-opencode-launch 1 0
printf '%s host=opencode shell-pid=%s host-pid=%s pgid=%s process-info=%s foreground-identity=%s foreground-commands=%s group-inventory=%s owned-peer=%s\n' \
  "$(stamp)" "$oc_shell_pid" "$oc_host_pid" "$oc_pgid" "$oc_info" "$(foreground_identity "$oc_info")" \
  "$(foreground_commands "$oc_info")" "$(process_group "$oc_pgid")" "$oc_peer_row"

# Exact Pi launch from profile package discovery.
pi_command="env PI_CODING_AGENT_DIR=$(quote "$pi_root") PI_OFFLINE=1 $(quote "$pi_binary") --no-session --no-skills --no-prompt-templates --no-themes --no-context-files"
checkpoint pre-pi-launch 1 0
pi_submitted=1
herdr pane run "$pi_pane" "$pi_command" >/dev/null
pi_info="$(wait_non_shell_group "$pi_pane" "$pi_shell_pid")"
pi_pgid="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$pi_info")"
pi_host_pid="$(host_pid_from_info "$pi_info")"
test "$pi_host_pid" = "$pi_pgid"
test -n "$(foreground_commands "$pi_info")"
test -n "$(process_group "$pi_pgid")"
# Classification is complete and recovery owns the group before the independent peer poll begins.
pi_live=1
pi_peer_row="$(wait_peer_for_exact_host_pid pi "$pi_host_pid")"
checkpoint post-pi-launch 1 1
printf '%s host=pi shell-pid=%s host-pid=%s pgid=%s process-info=%s foreground-identity=%s foreground-commands=%s group-inventory=%s owned-peer=%s\n' \
  "$(stamp)" "$pi_shell_pid" "$pi_host_pid" "$pi_pgid" "$pi_info" "$(foreground_identity "$pi_info")" \
  "$(foreground_commands "$pi_info")" "$(process_group "$pi_pgid")" "$pi_peer_row"
host_state="$(wait_media "$original_playing" hosts-initial)"
test "$host_state" = "$original_state"
wait_ui "$oc_pane" opencode "$original_state"
wait_ui "$pi_pane" pi "$original_state"

# OpenCode -> VLC -> Pi.
select_palette "$oc_pane" 'Music / Play / pause' 'Music' 'Play / pause'
checkpoint pre-opencode-control 1 1
herdr pane send-keys "$oc_pane" enter >/dev/null
oc_changed="$(wait_media "$opposite_playing" opencode-control)"
checkpoint post-opencode-control 1 1
wait_ui "$oc_pane" opencode "$oc_changed"
wait_ui "$pi_pane" pi "$oc_changed"

# Pi -> VLC -> OpenCode.
checkpoint pre-pi-control 1 1
herdr pane run "$pi_pane" '/music' >/dev/null
pi_restored="$(wait_media "$original_playing" pi-control)"
test "$pi_restored" = "$original_state"
checkpoint post-pi-control 1 1
wait_ui "$pi_pane" pi "$pi_restored"
wait_ui "$oc_pane" opencode "$pi_restored"

# Pi reload: pre-state and stale-message exclusion from both current sources.
reload_message='Reloaded keybindings, extensions, skills, prompts, themes, and context files'
pi_before_info="$(process_info "$pi_pane")"
pi_before_identity="$(foreground_identity "$pi_before_info")"
pi_before_commands="$(foreground_commands "$pi_before_info")"
pi_before_group="$(process_group "$pi_pgid")"
printf '%s pi-reload-before shell-pid=%s pgid=%s process-info=%s foreground-identity=%s foreground-commands=%s group-inventory=%s\n' \
  "$(stamp)" "$pi_shell_pid" "$pi_pgid" "$pi_before_info" "$pi_before_identity" "$pi_before_commands" "$pi_before_group"
capture_ui "$pi_pane"
pi_before_visible="$UI_TEXT"
pi_before_recent="$(herdr pane read "$pi_pane" --source recent-unwrapped --format text)"
test -z "$(grep -F -- "$reload_message" <<<"$(tr '\n' ' ' <<<"$pi_before_visible" | tr -s '[:space:]' ' ')" || true)"
test -z "$(grep -F -- "$reload_message" <<<"$(tr '\n' ' ' <<<"$pi_before_recent" | tr -s '[:space:]' ' ')" || true)"
herdr pane run "$pi_pane" '/reload' >/dev/null
reload_ready=0
reload_deadline=$((SECONDS+30))
while test "$SECONDS" -lt "$reload_deadline"; do
  if capture_ui "$pi_pane"; then
    current_visible="$UI_TEXT"
    current_recent="$(herdr pane read "$pi_pane" --source recent-unwrapped --format text)"
    current_combined="$(printf '%s\n%s\n' "$current_visible" "$current_recent" | tr '\n' ' ' | tr -s '[:space:]' ' ')"
    if grep -Fq -- "$reload_message" <<<"$current_combined" && assert_ui_text pi "$original_state" "$current_visible"; then
      checkpoint post-pi-reload-first-action 1 1
      pi_after_info="$(process_info "$pi_pane")"
      pi_after_identity="$(foreground_identity "$pi_after_info")"
      pi_after_commands="$(foreground_commands "$pi_after_info")"
      pi_after_group="$(process_group "$pi_pgid")"
      test "$pi_after_identity" = "$pi_before_identity"
