pid_is_absent() {
  local pid="$1" rc
  if ps -p "$pid" -o pid= >/dev/null 2>&1; then
    return 1
  else
    rc=$?
    test "$rc" -eq 1
  fi
}
sample_opencode_exit() {
  local pane="$1" shell="$2" host="$3" pgid="$4" info foreground group_rows host_absent=0 group_empty=0
  info="$(process_info "$pane")" || return 2
  foreground="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$info")" || return 2
  if pid_is_absent "$host"; then host_absent=1; fi
  group_rows="$(process_group "$pgid")" || return 2
  if test -z "$group_rows"; then group_empty=1; fi
  printf '%s opencode-exit-sample foreground=%s shell=%s host=%s host-absent=%s pgid=%s group-empty=%s process-info=%s group-rows=%s\n' \
    "$(stamp)" "$foreground" "$shell" "$host" "$host_absent" "$pgid" "$group_empty" "$info" "$group_rows"
  test "$foreground" = "$shell" && test "$host_absent" -eq 1 && test "$group_empty" -eq 1
}
wait_opencode_exit() {
  local pane="$1" shell="$2" host="$3" pgid="$4" deadline=$((SECONDS+60)) sample rc
  while test "$SECONDS" -lt "$deadline"; do
    if sample="$(sample_opencode_exit "$pane" "$shell" "$host" "$pgid")"; then
      printf '%s\n' "$sample"
      return 0
    else
      rc=$?
      printf '%s\n' "$sample" >&2
      test "$rc" -ne 2 || return "$rc"
    fi
    sleep 0.25
  done
  # Mandatory final fresh sample after the bounded loop, before failure.
  if sample="$(sample_opencode_exit "$pane" "$shell" "$host" "$pgid")"; then
    printf '%s opencode-exit-final-sample=pass\n%s\n' "$(stamp)" "$sample"
    return 0
  else
    rc=$?
    printf '%s opencode-exit-final-sample=fail rc=%s\n%s\n' "$(stamp)" "$rc" "$sample" >&2
    return 1
  fi
}
send_opencode_exit_once() {
  local pane="$1"
  test "$oc_exit_sent" -eq 0 || return 1
  oc_exit_sent=1
  printf '%s opencode-normal-command=/exit submission-count=1\n' "$(stamp)"
  herdr pane run "$pane" '/exit' >/dev/null
}
assert_recorded_pids_gone() {
  local info="$1" pids pid ps_rc
  pids="$(jq -er '
    .result.process_info.foreground_processes
    | if type == "array" and length > 0
        and all(.[]; (.pid | type) == "number" and .pid > 0 and .pid == (.pid | floor))
      then .[] | .pid
      else error("missing or invalid recorded foreground PID set")
      end
  ' <<<"$info")" || return 1
  test -n "$pids" || return 1
  while IFS= read -r pid; do
    test -n "$pid" || return 1
    if ps -p "$pid" -o pid= >/dev/null 2>&1; then
      return 1
    else
      ps_rc=$?
      test "$ps_rc" -eq 1 || return 1
    fi
  done <<<"$pids"
}

wait_peer_for_exact_host_pid() {
  local label="$1" host_pid="$2" deadline=$((SECONDS+20)) inventory rows
  test -n "$host_pid" || return 1
  # Ownership is intentionally not sampled at launch time: process-info classification
  # completes first, then this independent bounded lsof poll starts after a delay.
  sleep 0.25
  while test "$SECONDS" -lt "$deadline"; do
    inventory="$(peer_inventory)" || return 1
    rows="$(rows_for_pid "$inventory" "$host_pid")" || return 1
    if test "$(line_count "$rows")" -eq 1; then
      printf '%s exact-host-pid=%s owned-peer=%s row=%s\n' "$(stamp)" "$host_pid" "$label" "$rows" >&2
      printf '%s\n' "$rows"
      return 0
    fi
    sleep 0.25
  done
  return 1
}

raw_media() { media-control get --no-artwork | jq -Sce '.'; }
canonical_state() {
  jq -Sce '{bundleIdentifier,processIdentifier,title,artist,album,duration,playing}
    | select(
      (.bundleIdentifier|type=="string" and length>0) and
      (.processIdentifier|type=="number" and .>0 and floor==.) and
      (.title|type=="string" and length>0) and
      (.artist|type=="string") and
      (.album|type=="string") and
      (.duration|type=="number" and isfinite and .>=0) and
      (.playing|type=="boolean")
    )'
}
observe_media() {
  local label="$1" raw state raw_id
  raw="$(raw_media)" || return 1
  state="$(canonical_state <<<"$raw")" || return 1
  raw_id="$(jq -c 'if has("contentItemIdentifier") then .contentItemIdentifier else null end' <<<"$raw")" || return 1
  printf '%s media=%s raw-contentItemIdentifier=%s raw=%s canonical=%s\n' \
    "$(stamp)" "$label" "$raw_id" "$raw" "$state" >&2
  printf '%s\n' "$state"
}
identity_of() { jq -Sce 'del(.playing)' <<<"$1"; }
process_command_for() {
  local state="$1" pid
  pid="$(jq -er '.processIdentifier' <<<"$state")" || return 1
  ps -p "$pid" -o command=
}
assert_selected() {
  local state="$1"
  test "$(identity_of "$state")" = "$original_identity" || return 1
  test "$(process_command_for "$state")" = "$selected_command" || return 1
}
wait_media() {
  local wanted="$1" label="$2" deadline=$((SECONDS+20)) state
  while test "$SECONDS" -lt "$deadline"; do
    if state="$(observe_media "$label")" && assert_selected "$state" && test "$(jq -r '.playing' <<<"$state")" = "$wanted"; then
      printf '%s\n' "$state"
      return 0
    fi
    sleep 0.25
  done
  return 1
}
assert_stable_state() {
  local expected="$1" label="$2" index state
  for index in 1 2 3; do
    state="$(observe_media "$label-$index")" || return 1
    test "$state" = "$expected" || return 1
    test "$(process_command_for "$state")" = "$selected_command" || return 1
    test "$index" -eq 3 || sleep 0.5
  done
}

UI_TEXT=''
UI_ANSI=''
capture_ui() {
  local pane="$1" rc=0
  UI_TEXT=''; UI_ANSI=''
  herdr pane zoom --pane "$pane" --on >/dev/null || return 1
  UI_TEXT="$(herdr pane read "$pane" --source visible --format text)" || rc=1
  UI_ANSI="$(herdr pane read "$pane" --source visible --format ansi)" || rc=1
  herdr pane zoom --pane "$pane" --off >/dev/null || rc=1
  return "$rc"
}
assert_ui_text() {
  local host="$1" state="$2" text="$3"
  MUSIC_HOST="$host" MUSIC_STATE="$state" MUSIC_TEXT="$text" bun -e '
    const host = process.env.MUSIC_HOST
    const state = JSON.parse(process.env.MUSIC_STATE ?? "null")
    const text = (process.env.MUSIC_TEXT ?? "").normalize("NFC")
      .replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]+/g, " ")
      .replace(/\s+/g, " ").trim()
    const clean = (value) => String(value).normalize("NFC")
      .replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]+/g, " ")
      .replace(/\s+/g, " ").trim()
    const escape = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
    const truncate = (value, width) => {
      if (Bun.stringWidth(value) <= width) return value
      let result = ""
      for (const character of value) {
        if (Bun.stringWidth(result + character) > width - 1) break
        result += character
      }
      return `${result}…`
    }
    const clipWords = (value, max) => {
      const words = clean(value).split(/\s+/).filter(Boolean)
      return words.length <= max ? words.join(" ") : `${words.slice(0,max).join(" ")}…`
    }
    const marker = state.playing ? "⏸" : "▶"
    let pattern
    if (host === "opencode") {
      const title = truncate(clean(state.title), 28)
      // VLC/OpenCode can render marker + title without its nonempty backend artist.
      pattern = new RegExp(`${escape(marker)}(?:\\uFE0E)?\\s+${escape(title)}`, "g")
    } else if (host === "pi") {
      const title = clipWords(state.title, 6)
      // Pi convergence requires marker + waveform + title only.
      pattern = new RegExp(`${escape(marker)}\\s+[▁▂▃▄▅▆▇█]{16}\\s+${escape(title)}`, "g")
    } else throw new Error(`unknown host ${host}`)
    const matches = [...text.matchAll(pattern)]
    if (matches.length !== 1) throw new Error(`expected one coherent ${host} row, found ${matches.length}`)
    console.log(matches[0][0])
  '
}
assert_ui() {
  local pane="$1" host="$2" state="$3"
  capture_ui "$pane" || return 1
  ! grep -Eqi 'plugin failed|endpoint is occupied|unclassifiable peer|extension.*failed|Error:' <<<"$UI_TEXT" || return 1
  assert_ui_text "$host" "$state" "$UI_TEXT" || return 1
  printf '%s ui=%s canonical=%s\n%s\n' "$(stamp)" "$host" "$state" "$UI_ANSI"
}
wait_ui() {
  local pane="$1" host="$2" state="$3" deadline=$((SECONDS+20))
  while test "$SECONDS" -lt "$deadline"; do
    if assert_ui "$pane" "$host" "$state"; then return 0; fi
    sleep 0.25
  done
  return 1
}

select_palette() {
  local pane="$1" query="$2" group="$3" title="$4"
  herdr pane send-keys "$pane" escape >/dev/null || return 1
  herdr pane send-keys "$pane" ctrl+p >/dev/null || return 1
  herdr pane wait-output "$pane" --match 'Commands' --source visible --timeout 10000 >/dev/null || return 1
  herdr pane send-text "$pane" "$query" >/dev/null || return 1
  herdr pane wait-output "$pane" --match "$title" --source visible --timeout 10000 >/dev/null || return 1
  sleep 0.3 || return 1
  capture_ui "$pane" || return 1
  test -n "$UI_TEXT" || return 1
  test -n "$UI_ANSI" || return 1
  grep -Fq -- "$query" <<<"$UI_TEXT" || return 1
  grep -Fq -- "$group" <<<"$UI_TEXT" || return 1
  grep -Fq -- "$title" <<<"$UI_TEXT" || return 1
  printf '%s palette-query=%s expected-group=%s expected-title=%s\npalette-text-begin\n%s\npalette-text-end\npalette-ansi-begin\n%s\npalette-ansi-end\n' \
    "$(stamp)" "$query" "$group" "$title" "$UI_TEXT" "$UI_ANSI"
}

validate_root() {
  local root="$1" prefix="$2" owner parent processes
  test -d "$root" || return 1
  test ! -L "$root" || return 1
  owner="$(stat -f '%u' "$root")" || return 1
  test "$owner" = "$(id -u)" || return 1
  parent="$(realpath "$(dirname "$root")")" || return 1
  test "$parent" = "$tmp_base" || return 1
  case "$(basename "$root")" in "$prefix".*) ;; *) return 1 ;; esac
  processes="$(ps -axww -o command=)" || return 1
  ! grep -Fq -- "$root" <<<"$processes" || return 1
  printf '%s validated-root=%s\n' "$(stamp)" "$root"
}
delete_root() {
  local root="$1" prefix="$2"
  validate_root "$root" "$prefix" || return 1
  find "$root" -depth -delete || return 1
  test ! -e "$root" || return 1
  printf '%s deleted-owned-root=%s\n' "$(stamp)" "$root"
}

recover() {
  local rc="$1" current info
  trap - ERR
  set +e
  printf '%s recovery-start rc=%s oc-live=%s pi-live=%s oc-submitted=%s pi-submitted=%s tab=%s oc-root=%s pi-root=%s\n' \
    "$(stamp)" "$rc" "$oc_live" "$pi_live" "$oc_submitted" "$pi_submitted" "$tab_id" "$oc_root" "$pi_root" >&2
  assert_endpoint >&2
  if test -n "$baseline_socket" && test "$(assert_endpoint 2>/dev/null)" = "$baseline_socket"; then generation_once "$baseline_socket" >&2; fi
  peer_inventory >&2
  observe_media recovery >&2
  for current in "$oc_pane" "$pi_pane"; do
    test -n "$current" || continue
    process_info "$current" >&2
    herdr pane read "$current" --source visible --format text >&2
    herdr pane read "$current" --source visible --format ansi >&2
  done
  if test "$pi_live" -eq 1; then
    info="$(process_info "$pi_pane")"
    herdr pane run "$pi_pane" '/quit' >/dev/null
    wait_pi_shell "$pi_pane" "$pi_shell_pid" >/dev/null && assert_recorded_pids_gone "$info" && test -z "$(process_group "$pi_pgid")" && pi_live=0
  fi
  if test "$oc_live" -eq 1; then
    info="$(process_info "$oc_pane")"
    # Never submit twice: if normal shutdown already sent /exit, recovery only samples.
    if test "$oc_exit_sent" -eq 0; then send_opencode_exit_once "$oc_pane"; fi
    wait_opencode_exit "$oc_pane" "$oc_shell_pid" "$oc_host_pid" "$oc_pgid" >/dev/null &&
      assert_recorded_pids_gone "$info" && oc_live=0
  fi
  if test -n "$original_state"; then
    current="$(observe_media recovery-before-restore)"
    if test "$(identity_of "$current")" = "$original_identity" && test "$(process_command_for "$current")" = "$selected_command"; then
      if test "$(jq -r '.playing' <<<"$current")" != "$original_playing"; then media-control "$restore_action"; fi
      wait_media "$original_playing" recovery-restored >&2
    fi
  fi
  printf '%s recovery-preserved-uncertain-resources=true\n' "$(stamp)" >&2
  exit "$rc"
}
trap 'recover $?' ERR

