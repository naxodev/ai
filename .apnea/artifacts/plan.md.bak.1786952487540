baseline_socket="$(assert_endpoint)"
baseline_generation="$(generation_once "$baseline_socket")"
test -n "$baseline_generation"
checkpoint baseline 0 0
baseline_panes="$(herdr pane list --workspace "$workspace_id" | jq -r '.result.panes[].pane_id' | LC_ALL=C sort)"

