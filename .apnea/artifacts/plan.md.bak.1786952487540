import { createHash } from "node:crypto"
import { lstat, readFile, readdir, readlink, realpath } from "node:fs/promises"
import { relative, resolve } from "node:path"

const root = await realpath(".apnea")
const artifact = resolve(process.env.APNEA_PR_DESCRIPTION_ARTIFACT ?? "")
const artifactRel = relative(root, artifact).split("\\").join("/")
if (artifactRel.startsWith("../") || artifactRel === "" || artifactRel.startsWith("/")) {
