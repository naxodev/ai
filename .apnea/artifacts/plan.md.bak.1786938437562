    let representation
    if (host === "opencode") {
      representation = `${marker}\uFE0E ${truncate(sanitize(state.title), 28)} - ${truncate(sanitize(state.artist), 20)}`
      pattern = new RegExp(escape(representation), "g")
    } else if (host === "pi") {
      const identity = `${clipWords(state.title, 6)} · ${clipWords(state.artist, 4)}`
      representation = `${marker} <waveform> ${identity}`
      pattern = new RegExp(`${escape(marker)}\\s+\\S+\\s+${escape(identity)}`, "g")
    } else throw new Error(`unknown host ${host}`)
    const matches = [...text.matchAll(pattern)]
    if (matches.length !== 1) {
      throw new Error(`expected exactly one coherent ${host} music status ${JSON.stringify(representation)}, found ${matches.length}`)
    }
    console.log(`coherent ${host} music status: ${matches[0][0]}`)
  '
  printf '%s ui=%s state=%s\n%s\n' "$(date -u +%FT%TZ)" "$host" "$state" "$UI_ANSI"
}
select_oc_palette_action() {
  local pane="$1" query="$2" group="$3" title="$4"
  herdr pane send-keys "$pane" escape >/dev/null
  sleep 0.1
  herdr pane send-keys "$pane" ctrl+p >/dev/null
  herdr pane wait-output "$pane" --match 'Commands' --source visible --timeout 10000 >/dev/null
  herdr pane send-text "$pane" "$query" >/dev/null
  herdr pane wait-output "$pane" --match "$title" --source visible --timeout 10000 >/dev/null
  sleep 0.3
  capture_ui "$pane"
  grep -Fq -- "$query" <<<"$UI_TEXT"
  PALETTE_ANSI="$UI_ANSI" PALETTE_TITLE="$title" PALETTE_GROUP="$group" bun -e '
    const ansi = process.env.PALETTE_ANSI ?? ""
    const title = process.env.PALETTE_TITLE ?? ""
    const group = process.env.PALETTE_GROUP ?? ""
    const strip = (s) => s.replace(/\x1b\[[0-?]*[ -\/]*[@-~]/g, "")
    const boldAtTitle = (line) => {
      const index = line.indexOf(title)
      if (index < 0) return false
      let bold = false
      for (const match of line.slice(0, index).matchAll(/\x1b\[([0-9;]*)m/g)) {
        const params = match[1] === "" ? [0] : match[1].split(";").map(Number)
        for (const value of params) {
          if (value === 0 || value === 22) bold = false
          if (value === 1) bold = true
        }
      }
      return bold
    }
    const candidates = ansi.split("\n").filter((line) => {
      const plain = strip(line)
      return plain.includes(title) && plain.includes(group)
    })
    const selected = candidates.filter(boldAtTitle)
    if (selected.length !== 1) {
      throw new Error(`expected one visibly bold selected ${group} / ${title} row; candidates=${candidates.length} selected=${selected.length}`)
    }
    console.log(`selected palette row: ${strip(selected[0]).trim()}`)
  '
  printf '%s palette-query=%s selected=%s/%s\n%s\n' \
    "$(date -u +%FT%TZ)" "$query" "$group" "$title" "$UI_ANSI"
}
cleanup_owned_root() {
  local root="$1" prefix="$2" processes
  test -d "$root" && test ! -L "$root"
  test "$(stat -f '%u' "$root")" = "$(id -u)"
  test "$(realpath "$(dirname "$root")")" = "$tmp_base"
  case "$(basename "$root")" in "$prefix".*) ;; *) return 1 ;; esac
  processes="$(ps -axww -o command=)"
  ! grep -Fq -- "$root" <<<"$processes"
  find "$root" -depth -delete
  test ! -e "$root"
}

# A rejected candidate returns 1 only after proving it is unchanged/restored.
# Return 2 means exact restoration or protected-boundary evidence failed: stop.
# No path returns after a possible transition until bounded re-observation and,
# when the opposite state is seen, a guarded restoration attempt have completed.
certify_media_candidate() {
  local label="$1" original playing opposite toggle_rc=0 boundary_rc=0 observed=''
  local current='' restore_rc=0 restored=''
  original="$(media_snapshot)" || return 2
  assert_live_music_app "$original" || return 2
  playing="$(jq -r .playing <<<"$original")"
  if test "$playing" = true; then opposite=false; else opposite=true; fi
  printf '%s candidate-source=%s original=%s\n' "$(date -u +%FT%TZ)" "$label" "$original"
  checkpoint pre-media-control-candidate-toggle 0 0 || return 2
  media-control toggle-play-pause || toggle_rc=$?
  checkpoint post-media-control-candidate-toggle 0 0 || boundary_rc=1

  # Prefer the already-observed opposite snapshot. If that times out, perform a
  # second bounded observation that can distinguish exact-original, opposite,
  # changed identity, and unavailable metadata. Never take one fallible snapshot
  # and return before deciding whether restoration is required.
  if observed="$(wait_media_state "$original" "$opposite")"; then
    current="$observed"
  elif current="$(observe_candidate_state "$original")"; then
    :
  else
    printf '%s candidate-state-unknown-after-toggle source=%s original=%s toggle_rc=%s; no further media command issued\n' \
      "$(date -u +%FT%TZ)" "$label" "$original" "$toggle_rc" >&2
    return 2
  fi

  if same_identity "$original" "$current" &&
     test "$(jq -r .playing <<<"$current")" = "$opposite"; then
    # Restoration is mandatory even after a failed toggle status or protected
    # checkpoint. A successful restore cannot downgrade missing boundary evidence.
    checkpoint pre-media-control-candidate-restore 0 0 || boundary_rc=1
    media-control toggle-play-pause || restore_rc=$?
    checkpoint post-media-control-candidate-restore 0 0 || boundary_rc=1
    if restored="$(wait_media_state "$original" "$playing")"; then :; else restored=''; fi
    if test -z "$restored" || test "$restored" != "$original"; then
      printf '%s candidate-restoration-unproven source=%s original=%s opposite=%s latest=%s restore_rc=%s\n' \
        "$(date -u +%FT%TZ)" "$label" "$original" "$current" "$restored" "$restore_rc" >&2
      return 2
    fi
    printf '%s candidate-restored source=%s toggle_rc=%s restore_rc=%s boundary_rc=%s original=%s opposite=%s restored=%s\n' \
      "$(date -u +%FT%TZ)" "$label" "$toggle_rc" "$restore_rc" "$boundary_rc" "$original" "$current" "$restored"
    test "$boundary_rc" -eq 0 || return 2
    if test "$toggle_rc" -eq 0 && test "$restore_rc" -eq 0 && test -n "$observed"; then
      chosen_original="$original"
      chosen_playing="$playing"
      chosen_opposite="$opposite"
      chosen_source="$label"
      return 0
    fi
    return 1
  fi

  # A retry is allowed only when bounded observation proves the byte-identical
  # original is still active and every protected checkpoint succeeded.
  if test "$current" = "$original"; then
    printf '%s candidate-uncontrollable-but-unchanged source=%s toggle_rc=%s boundary_rc=%s state=%s\n' \
      "$(date -u +%FT%TZ)" "$label" "$toggle_rc" "$boundary_rc" "$current"
    test "$boundary_rc" -eq 0 || return 2
    return 1
  fi
  printf '%s candidate-state-not-restorable source=%s original=%s current=%s; preserving observed state and stopping\n' \
    "$(date -u +%FT%TZ)" "$label" "$original" "$current" >&2
  return 2
}

# Concrete normal-exit/error recovery; never sends a signal. It captures the
# owned tab/panes/processes/groups/peers/UI before and after normal-exit attempts,
# and never closes a live or unclassified launched-host tab. Submission is
# tracked before process discovery.
restore_original_directly() {
  local current rc=0 restored
  test -n "$chosen_original" || return 0
  current="$(media_snapshot)" || return 1
  test "$current" = "$chosen_original" && return 0
  same_identity "$chosen_original" "$current" || return 1
  test "$(jq -r .playing <<<"$current")" = "$chosen_opposite" || return 1
  checkpoint_live recovery-pre-media-restore || rc=1
  media-control toggle-play-pause || rc=1
  checkpoint_live recovery-post-media-restore || rc=1
  restored="$(wait_media_state "$chosen_original" "$chosen_playing")" || return 1
  test "$restored" = "$chosen_original" || return 1
  return "$rc"
}
capture_recovery_state() {
  local label="$1" pane info pgid
  printf '%s recovery-evidence=%s tab=%s oc-pane=%s pi-pane=%s oc-root=%s pi-root=%s oc-pgid=%s pi-pgid=%s oc-peer-pid=%s pi-peer-pid=%s oc-returned=%s pi-returned=%s\n' \
    "$(date -u +%FT%TZ)" "$label" "$tab_id" "$oc_pane" "$pi_pane" "$oc_root" "$pi_root" \
    "$oc_pgid" "$pi_pgid" "$oc_peer_pid" "$pi_peer_pid" "$oc_shell_returned" "$pi_shell_returned" >&2
  printf '%s recovery-endpoint=%s generation=%s peers=%s media=%s\n' \
    "$(date -u +%FT%TZ)" "$(assert_endpoint)" "$(direct_generation)" \
    "$(peer_inventory_once)" "$(media_snapshot)" >&2
  for pane in "$oc_pane" "$pi_pane"; do
    test -n "$pane" || continue
    printf '%s recovery-pane=%s get=%s\n' "$(date -u +%FT%TZ)" "$pane" "$(herdr pane get "$pane")" >&2
    info="$(process_info "$pane")"
    pgid="$(jq -r '.result.process_info.foreground_process_group_id // empty' <<<"$info")"
    printf '%s recovery-pane=%s info=%s commands=%s group=%s text=%s ansi=%s\n' \
      "$(date -u +%FT%TZ)" "$pane" "$info" "$(foreground_commands "$info")" \
      "$(test -n "$pgid" && process_group_inventory "$pgid")" \
      "$(herdr pane read "$pane" --source visible --format text)" \
      "$(herdr pane read "$pane" --source visible --format ansi)" >&2
  done
}
recover_owned_run() {
  local original_rc="$1" info foreground row current
  trap - ERR
  set +e
  printf '%s recovery-start rc=%s oc_live=%s pi_live=%s oc_submitted=%s pi_submitted=%s\n' \
    "$(date -u +%FT%TZ)" "$original_rc" "$oc_live" "$pi_live" "$oc_submitted" "$pi_submitted" >&2
  capture_recovery_state before-normal-exit-attempts

  # A submitted-but-unclassified launch is inspected once. It becomes eligible
  # for normal exit only after a real non-shell PGID and foreground set exist.
  if test "$pi_submitted" -eq 1 && test "$pi_live" -eq 0 && test -n "$pi_pane"; then
    if test "$pi_shell_returned" -eq 1; then
      current="$(peer_inventory_once)"
      if test -n "$pi_peer_pid" && assert_peer_pid_absent "$current" "$pi_peer_pid"; then
        pi_submitted=0
      else
        printf '%s recovery-pi-returned-but-peer-not-proven-absent; leaving pane/root/tab\n' "$(date -u +%FT%TZ)" >&2
      fi
    else
      info="$(process_info "$pi_pane")"
      foreground="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$info")"
      if test "$foreground" != "$pi_shell_pid" && test -n "$(foreground_commands "$info")"; then
        pi_pgid="$foreground"
        pi_live=1
      else
        printf '%s recovery-pi-launch-unclassified; leaving pane/root/tab\n' "$(date -u +%FT%TZ)" >&2
      fi
    fi
  fi
  if test "$pi_live" -eq 1 && test -n "$pi_pane"; then
    info="$(process_info "$pi_pane")"
    if test -z "$pi_peer_pid"; then
      row="$(capture_owned_peer pi-recovery "$pi_pgid")"
      if test "$(row_count "$row")" -eq 1; then
        pi_peer_row="$row"
        pi_peer_pid="$(awk -F '\t' 'NR == 1 { print $1 }' <<<"$row")"
      fi
    fi
    printf '%s recovery-pi-before-quit info=%s commands=%s group=%s peer=%s\n' \
      "$(date -u +%FT%TZ)" "$info" "$(foreground_commands "$info")" \
      "$(process_group_inventory "$pi_pgid")" "$pi_peer_row" >&2
    checkpoint_live recovery-pre-pi-quit
    herdr pane run "$pi_pane" '/quit' >/dev/null
    if wait_shell_return "$pi_pane" "$pi_shell_pid" >/dev/null &&
       assert_recorded_pids_gone "$info" && assert_group_empty "$pi_pgid"; then
      pi_shell_returned=1
      pi_live=0
      current="$(peer_inventory_once)"
      if test -n "$pi_peer_pid" && assert_peer_pid_absent "$current" "$pi_peer_pid"; then
        pi_submitted=0
        checkpoint_live recovery-post-pi-quit
      fi
    fi
  fi

  if test "$oc_submitted" -eq 1 && test "$oc_live" -eq 0 && test -n "$oc_pane"; then
    if test "$oc_shell_returned" -eq 1; then
      current="$(peer_inventory_once)"
      if test -n "$oc_peer_pid" && assert_peer_pid_absent "$current" "$oc_peer_pid"; then
        oc_submitted=0
      else
        printf '%s recovery-opencode-returned-but-peer-not-proven-absent; leaving pane/root/tab\n' "$(date -u +%FT%TZ)" >&2
      fi
    else
      info="$(process_info "$oc_pane")"
      foreground="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$info")"
      if test "$foreground" != "$oc_shell_pid" && test -n "$(foreground_commands "$info")"; then
        oc_pgid="$foreground"
        oc_live=1
      else
        printf '%s recovery-opencode-launch-unclassified; leaving pane/root/tab\n' "$(date -u +%FT%TZ)" >&2
      fi
    fi
  fi
  if test "$oc_live" -eq 1 && test -n "$oc_pane"; then
    info="$(process_info "$oc_pane")"
    if test -z "$oc_peer_pid"; then
      row="$(capture_owned_peer opencode-recovery "$oc_pgid")"
      if test "$(row_count "$row")" -eq 1; then
        oc_peer_row="$row"
        oc_peer_pid="$(awk -F '\t' 'NR == 1 { print $1 }' <<<"$row")"
      fi
    fi
    printf '%s recovery-opencode-before-exit info=%s commands=%s group=%s peer=%s\n' \
      "$(date -u +%FT%TZ)" "$info" "$(foreground_commands "$info")" \
      "$(process_group_inventory "$oc_pgid")" "$oc_peer_row" >&2
    if select_oc_palette_action "$oc_pane" 'Exit' 'System' 'Exit the app'; then
      checkpoint_live recovery-pre-opencode-exit
      herdr pane send-keys "$oc_pane" enter >/dev/null
      if wait_shell_return "$oc_pane" "$oc_shell_pid" >/dev/null &&
         assert_recorded_pids_gone "$info" && assert_group_empty "$oc_pgid"; then
        oc_shell_returned=1
        oc_live=0
        current="$(peer_inventory_once)"
        if test -n "$oc_peer_pid" && assert_peer_pid_absent "$current" "$oc_peer_pid"; then
          oc_submitted=0
          checkpoint_live recovery-post-opencode-exit
        fi
      fi
    fi
  fi

  restore_original_directly || printf '%s recovery-playback-not-proven\n' "$(date -u +%FT%TZ)" >&2
  capture_recovery_state after-normal-exit-attempts
  if test -n "$pi_root" && test -e "$pi_root" && test "$pi_submitted" -eq 0 &&
     test "$pi_live" -eq 0 && test "$pi_pgid" != -1; then
    assert_group_empty "$pi_pgid" && cleanup_owned_root "$pi_root" pi-mixed
  fi
  if test -n "$oc_root" && test -e "$oc_root" && test "$oc_submitted" -eq 0 &&
     test "$oc_live" -eq 0 && test "$oc_pgid" != -1; then
    assert_group_empty "$oc_pgid" && cleanup_owned_root "$oc_root" opencode-next-17386
  fi
  if test -n "$tab_id" && test "$pi_submitted" -eq 0 && test "$oc_submitted" -eq 0 &&
     test "$pi_live" -eq 0 && test "$oc_live" -eq 0; then
    herdr tab close "$tab_id" >/dev/null
  else
    printf '%s recovery-left-owned-resources tab=%s oc_root=%s pi_root=%s oc_submitted=%s pi_submitted=%s\n' \
      "$(date -u +%FT%TZ)" "$tab_id" "$oc_root" "$pi_root" "$oc_submitted" "$pi_submitted" >&2
  fi
  exit "$original_rc"
}
