direct_generation() {
  local expected="$1" before observed after
  # The tuple comparison is inside the probing primitive so no caller can
  # connect merely because the replacement endpoint is internally stable.
  test -n "$expected" || return 1
  before="$(assert_endpoint)" || return 1
  test "$before" = "$expected" || return 1
  observed="$(MUSIC_SESSION_SOCKET="$socket" bun -e '
    import { baselineCapabilities, createMusicSessionClient } from "./packages/music-core/index.ts"
    const socketPath = process.env.MUSIC_SESSION_SOCKET
    if (!socketPath) throw new Error("missing explicit socket")
    const client = await createMusicSessionClient({
      socketPath,
      clientId: `final-cert-${process.pid}`,
      hostKind: "test",
      capabilities: [...baselineCapabilities],
    })
    try { console.log(client.daemonInstanceId) } finally { client.dispose() }
  ')" || return 1
  after="$(assert_endpoint)" || return 1
  test "$after" = "$expected" || return 1
  test -n "$observed" || return 1
  printf '%s\n' "$observed" || return 1
}
peer_inventory_once() {
  local tokens all token pid fd command rows=''
  tokens="$(lsof -n -a -U -p "$daemon_pid" | awk -v path="$socket" \
    '$NF == path { print $6 }' | LC_ALL=C sort -u)" || return 1
  test -n "$tokens" || return 1
  all="$(lsof -n -U)" || return 1
  for token in $tokens; do
    while read -r pid fd; do
      test -n "$pid" || continue
      command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
      # An unrelated client may exit between lsof and ps; omit that stale row.
      test -n "$command" || continue
      rows+="$(printf '%s\t%s\t%s\t%s' "$pid" "$fd" "->$token" "$command")"$'\n'
    done < <(printf '%s\n' "$all" | awk -v target="->$token" -v daemon="$daemon_pid" \
      '$NF == target && $2 != daemon { print $2, $4 }')
  done
  test -z "$rows" || printf '%s' "$rows" | LC_ALL=C sort || return 1
}
row_count() {
  if test -z "$1"; then printf '0\n'; else printf '%s\n' "$1" | awk 'END {print NR}'; fi
