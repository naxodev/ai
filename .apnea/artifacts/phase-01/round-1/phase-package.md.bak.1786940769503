rows_for_pgid() {
  local inventory="$1" wanted="$2" pid fd endpoint command pgid
  test "$wanted" != -1 || return 0
  while IFS=$'\t' read -r pid fd endpoint command; do
    test -n "$pid" || continue
    pgid="$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d ' ')"
    if test "$pgid" = "$wanted"; then
      printf '%s\t%s\t%s\t%s\n' "$pid" "$fd" "$endpoint" "$command" || return 1
    fi
