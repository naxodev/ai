jq -n --arg package "$pi_package" '{packages:[$package]}' >"$pi_root/settings.json"
test "$(jq -r '.packages|length' "$pi_root/settings.json")" -eq 1
test "$(jq -r '.packages[0]' "$pi_root/settings.json")" = "$pi_package"
test "$(bunx --package @earendil-works/pi-coding-agent@0.84.0 pi --version)" = 0.84.0
printf 'pi-root=%s version=0.84.0 settings=%s\n' "$pi_root" "$(cat "$pi_root/settings.json")"

# Returned regular-pane topology only.
controller="$(herdr pane current --current)"
