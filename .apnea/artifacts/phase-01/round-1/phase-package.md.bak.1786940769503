  pi="$(rows_for_pgid "$current" "$pi_pgid")" || return 1
  test "$(row_count "$oc")" -eq "$want_oc" || return 1
  test "$(row_count "$pi")" -eq "$want_pi" || return 1
  if test "$want_oc" -eq 1 && test -n "$oc_peer_pid"; then
    test "$(awk -F '\t' 'NR == 1 { print $1 }' <<<"$oc")" = "$oc_peer_pid" || return 1
  fi
