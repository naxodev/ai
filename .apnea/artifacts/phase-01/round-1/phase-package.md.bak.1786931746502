#### Exact isolated OpenCode attachment

Use a fresh regular pane. Do not use the mutable global `opencode2`. Create an isolated install outside the repository with the required trusted postinstall declaration:

```sh
set -eu
tmp_base="${TMPDIR:-/tmp}"; tmp_base="${tmp_base%/}"
oc_root="$(mktemp -d "$tmp_base/opencode-next-17386.XXXXXX")"
cleanup_oc() {
  test -n "${oc_root:-}" || return 0
  test -d "$oc_root" && test ! -L "$oc_root"
  test "$(stat -f '%u' "$oc_root")" = "$(id -u)"
  test "$(realpath "$(dirname "$oc_root")")" = "$(realpath "$tmp_base")"
  case "$(basename "$oc_root")" in opencode-next-17386.*) ;; *) return 1 ;; esac
  rm -rf -- "$oc_root"
}
trap cleanup_oc EXIT HUP INT TERM
cat >"$oc_root/package.json" <<'JSON'
{
  "private": true,
  "dependencies": {
    "@opencode-ai/cli": "0.0.0-next-17386"
  },
  "trustedDependencies": ["@opencode-ai/cli"]
}
JSON
(cd "$oc_root" && bun install)
oc_bin="$(realpath "$oc_root/node_modules/.bin/opencode2")"
case "$oc_bin" in "$oc_root"/node_modules/*) ;; *) echo 'temporary OpenCode binary escaped install root' >&2; exit 1 ;; esac
test "$("$oc_bin" --version)" = 'opencode2 v0.0.0-next-17386'
mkdir "$oc_root/config"
plugin="$(realpath packages/opencode-music-player)"
printf '{"plugins":["%s"]}\n' "$plugin" >"$oc_root/config/cli.json"
test "$(cat "$oc_root/config/cli.json")" = "{\"plugins\":[\"$plugin\"]}"
printf 'oc_root=%s oc_bin=%s plugin=%s\n' "$oc_root" "$oc_bin" "$plugin"
OPENCODE_CONFIG_DIR="$oc_root/config" OPENCODE_CONFIG_PROJECT_DISABLE=1 OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_MODELS_FETCH=1 "$oc_bin" --standalone --log-level error "$PWD"
