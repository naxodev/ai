# Close only the owned returned tab after both normal exits and root cleanup.
test "$(herdr pane list --workspace "$HERDR_WORKSPACE_ID" | jq -r \
  --arg tab "$tab_id" '.result.panes[] | select(.tab_id == $tab) | .pane_id' | LC_ALL=C sort)" = "$owned_ids"
herdr tab close "$tab_id" >/dev/null
! herdr pane get "$oc_pane" >/dev/null 2>&1
! herdr pane get "$pi_pane" >/dev/null 2>&1
printf 'certified original=%s baseline_peers=%s controller=%s owned_tab=%s\n' \
  "$original_state" "$baseline_peer_count" "$controller_pane" "$tab_id"
