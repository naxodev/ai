sleep 0.5
assert_ui "$oc_pane" opencode "$restored"
checkpoint post-pi-opencode-restored 1 0

# Normal OpenCode exit: capture exact foreground/group evidence, prove all
# recorded PIDs and the complete host PGID are gone, then clean the owned root.
oc_exit_info="$(process_info "$oc_pane")"
test "$(jq -er '.result.process_info.foreground_process_group_id' <<<"$oc_exit_info")" = "$oc_pgid"
oc_exit_identity="$(foreground_identity "$oc_exit_info")"
