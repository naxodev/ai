printf '%s\n' "$oc_shell_return"
assert_recorded_foreground_gone "$oc_exit_info"
assert_process_group_empty "$oc_pgid"
checkpoint post-opencode-quit 0 0
cleanup_owned_root "$oc_root" opencode-next-17386
oc_pgid=-1
final_peers="$(stable_peers)"
test "$final_peers" = "$baseline_peers"
test "$(assert_endpoint)" = "$baseline_socket"
test "$(direct_generation)" = "$baseline_generation"
test "$(assert_endpoint)" = "$baseline_socket"
