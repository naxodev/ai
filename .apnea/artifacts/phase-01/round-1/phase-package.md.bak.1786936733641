  observed="$(MUSIC_SESSION_SOCKET="$socket" bun -e '
    import { baselineCapabilities, createMusicSessionClient } from "./packages/music-core/index.ts"
    const socketPath = process.env.MUSIC_SESSION_SOCKET
    if (!socketPath) throw new Error("missing validated socket")
    const client = await createMusicSessionClient({
      socketPath,
      clientId: `mixed-cert-${process.pid}`,
      hostKind: "test",
