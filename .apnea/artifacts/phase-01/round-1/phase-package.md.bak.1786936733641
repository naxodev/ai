printf 'pi-info-after-reload=%s\npi-identity-after-reload=%s\npi-commands-after-reload=%s\npi-group-after-reload=%s\n' \
  "$pi_info_after_reload" "$pi_identity_after_reload" \
  "$pi_commands_after_reload" "$pi_group_after_reload"

# Normal Pi exit: retain exact foreground and group evidence, then prove every
