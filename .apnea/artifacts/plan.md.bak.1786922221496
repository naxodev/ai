Run from the repository root after adding the one ignore entry:

```sh
test "$(grep -cFx '.apnea/' .prettierignore)" -eq 1
bunx prettier --file-info .apnea/state.json | grep -q '"ignored": true'
hash_apnea() {
  find .apnea -type f -print0 | sort -z | while IFS= read -r -d '' file; do
    shasum -a 256 "$file"
