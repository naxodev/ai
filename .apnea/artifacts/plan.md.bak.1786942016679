wait_shell_return() {
  local pane="$1" shell="$2" deadline=$((SECONDS+30)) info pgid
  while test "$SECONDS" -lt "$deadline"; do
    info="$(process_info "$pane")" || return 1
    pgid="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$info")" || return 1
    if test "$pgid" = "$shell"; then printf '%s\n' "$info" || return 1; return 0; fi
    sleep 0.25
  done
  return 1
}
direct_music_app_inspection() {
  printf '%s direct-music-command=%s\n' "$(date -u +%FT%TZ)" \
    "ps -axww -o pid=,command= | grep '[M]usic.app/Contents/MacOS/Music'" >&2
  ps -axww -o pid=,command= | grep '[M]usic.app/Contents/MacOS/Music' >&2 || return 1
  printf '%s direct-music-command=%s\n' "$(date -u +%FT%TZ)" \
    "osascript -e 'tell application id \"com.apple.Music\"' -e 'set t to current track' -e 'return {player state as text, player position, database ID of t, name of t, artist of t, album of t}' -e 'end tell'" >&2
  osascript \
    -e 'tell application id "com.apple.Music"' \
    -e 'set t to current track' \
    -e 'return {player state as text, player position, database ID of t, name of t, artist of t, album of t}' \
    -e 'end tell' >&2 || return 1
}
assert_direct_music_app_matches() {
  local expected="$1" name artist album state playing
  direct_music_app_inspection || return 1
  name="$(osascript -e 'tell application id "com.apple.Music" to get name of current track')" || return 1
  artist="$(osascript -e 'tell application id "com.apple.Music" to get artist of current track')" || return 1
  album="$(osascript -e 'tell application id "com.apple.Music" to get album of current track')" || return 1
  state="$(osascript -e 'tell application id "com.apple.Music" to get player state as text')" || return 1
  test "$name" = 'P1-C2' || return 1
  test "$name" = "$(jq -er .title <<<"$expected")" || return 1
  test "$artist" = "$(jq -er .artist <<<"$expected")" || return 1
  test "$album" = "$(jq -er .album <<<"$expected")" || return 1
  playing="$(jq -er .playing <<<"$expected")" || return 1
  if test "$playing" = true; then
    test "$state" = playing || return 1
  else
    test "$state" != playing || return 1
  fi
  printf '%s direct-music-match name=%s artist=%s album=%s state=%s expected=%s\n' \
    "$(date -u +%FT%TZ)" "$name" "$artist" "$album" "$state" "$expected" || return 1
}
media_snapshot() {
  local raw bundle
  raw="$(media-control get --no-artwork | jq -Sce '.')" || return 1
  bundle="$(jq -er '.bundleIdentifier' <<<"$raw")" || return 1
  if test "$bundle" != 'com.apple.Music'; then
    printf '%s media-control-selected-non-music payload=%s\n' "$(date -u +%FT%TZ)" "$raw" >&2
    direct_music_app_inspection || return 1
    return 1
  fi
  jq -Sce '
    {bundleIdentifier,processIdentifier,contentItemIdentifier,
     id:(.contentItemIdentifier // .title),title,artist,album,duration,playing,playbackRate}
    | select(.bundleIdentifier == "com.apple.Music"
      and (.processIdentifier|type=="number" and . > 0 and floor == .)
      and (.id|type=="string" and length>0)
      and (.title|type=="string" and length>0)
      and (.artist|type=="string" and length>0)
      and (.playing|type=="boolean"))' <<<"$raw"
}
assert_live_music_app() {
  local state="$1" pid command
  pid="$(jq -er .processIdentifier <<<"$state")" || return 1
  command="$(ps -p "$pid" -o command=)" || return 1
  test -n "$command" || return 1
  case "$command" in *'/Music.app/Contents/MacOS/Music'*) ;; *) return 1 ;; esac
  printf 'music-app pid=%s command=%s state=%s\n' "$pid" "$command" "$state" || return 1
}
same_identity() {
  local left right
  left="$(jq -er '[.bundleIdentifier,.processIdentifier,.id,.title,.artist]|@tsv' <<<"$1")" || return 1
  right="$(jq -er '[.bundleIdentifier,.processIdentifier,.id,.title,.artist]|@tsv' <<<"$2")" || return 1
  test "$left" = "$right" || return 1
}
wait_media_state() {
  local identity="$1" wanted="$2" deadline=$((SECONDS+15)) current
  while test "$SECONDS" -lt "$deadline"; do
    if current="$(media_snapshot)" && same_identity "$identity" "$current" &&
       test "$(jq -r .playing <<<"$current")" = "$wanted"; then
      printf '%s\n' "$current"
      return 0
    fi
    sleep 0.25
  done
  return 1
}
observe_candidate_state() {
  local identity="$1" deadline=$((SECONDS+15)) current last=''
  while test "$SECONDS" -lt "$deadline"; do
    if current="$(media_snapshot)"; then
      last="$current"
      if same_identity "$identity" "$current"; then
        printf '%s\n' "$current"
        return 0
      fi
    fi
    sleep 0.25
  done
  if test -n "$last"; then
    printf '%s candidate-reobservation-changed expected=%s latest=%s\n' \
      "$(date -u +%FT%TZ)" "$identity" "$last" >&2
    printf '%s\n' "$last"
    return 0
  fi
  printf '%s candidate-reobservation-unavailable expected=%s\n' \
    "$(date -u +%FT%TZ)" "$identity" >&2
  return 1
}

UI_TEXT=''
UI_ANSI=''
capture_ui() {
  local pane="$1" zoom_on_rc=0 text_rc=0 ansi_rc=0 zoom_off_rc=0
  UI_TEXT=''
  UI_ANSI=''
  herdr pane zoom --pane "$pane" --on >/dev/null || zoom_on_rc=$?
  if test "$zoom_on_rc" -eq 0; then
    UI_TEXT="$(herdr pane read "$pane" --source visible --format text)" || text_rc=$?
    UI_ANSI="$(herdr pane read "$pane" --source visible --format ansi)" || ansi_rc=$?
  else
    # Do not accept fallback reads from the split viewport.
    text_rc=125
    ansi_rc=125
  fi
  # Always attempt to restore topology, while retaining every prior failure.
  herdr pane zoom --pane "$pane" --off >/dev/null || zoom_off_rc=$?
  test "$zoom_on_rc" -eq 0 || return 1
  test "$text_rc" -eq 0 || return 1
  test "$ansi_rc" -eq 0 || return 1
  test "$zoom_off_rc" -eq 0 || return 1
  return 0
}
assert_ui() {
  local pane="$1" host="$2" state="$3"
  capture_ui "$pane" || return 1
  if grep -Eqi '1 plugin failed|music session endpoint is occupied|unclassifiable peer|extension.*failed|Error:' <<<"$UI_TEXT"; then
    return 1
  fi
  MUSIC_UI_TEXT="$UI_TEXT" MUSIC_UI_HOST="$host" MUSIC_UI_STATE="$state" bun -e '
    const text = process.env.MUSIC_UI_TEXT ?? ""
    const host = process.env.MUSIC_UI_HOST ?? ""
    const state = JSON.parse(process.env.MUSIC_UI_STATE ?? "null")
    const sanitize = (value) => value.normalize("NFC")
      .replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]+/g, " ")
      .replace(/\s+/g, " ").trim()
    const clipWords = (value, max) => {
      const words = value.trim().split(/\s+/).filter(Boolean)
      return words.length <= max ? value.trim() : `${words.slice(0, max).join(" ")}…`
    }
    const truncate = (value, width) => {
      if (Bun.stringWidth(value) <= width) return value
      if (width <= 1) return "…"
      let result = ""
      for (const character of value) {
        if (Bun.stringWidth(result + character) > width - 1) break
        result += character
      }
      return `${result}…`
    }
    const escape = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
    const marker = state.playing ? "⏸" : "▶"
    let pattern
    let representation
    if (host === "opencode") {
      representation = `${marker}\uFE0E ${truncate(sanitize(state.title), 28)} - ${truncate(sanitize(state.artist), 20)}`
      pattern = new RegExp(escape(representation), "g")
    } else if (host === "pi") {
      const identity = `${clipWords(state.title, 6)} · ${clipWords(state.artist, 4)}`
      representation = `${marker} <waveform> ${identity}`
      pattern = new RegExp(`${escape(marker)}\\s+\\S+\\s+${escape(identity)}`, "g")
    } else throw new Error(`unknown host ${host}`)
    const matches = [...text.matchAll(pattern)]
    if (matches.length !== 1) {
      throw new Error(`expected exactly one coherent ${host} music status ${JSON.stringify(representation)}, found ${matches.length}`)
    }
    console.log(`coherent ${host} music status: ${matches[0][0]}`)
  ' || return 1
  printf '%s ui=%s state=%s\n%s\n' "$(date -u +%FT%TZ)" "$host" "$state" "$UI_ANSI" || return 1
}
pi_output_has_state() {
  MUSIC_UI_TEXT="$1" MUSIC_UI_STATE="$2" bun -e '
    const text = process.env.MUSIC_UI_TEXT ?? ""
    const state = JSON.parse(process.env.MUSIC_UI_STATE ?? "null")
    const sanitize = (value) => value.normalize("NFC")
      .replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]+/g, " ")
      .replace(/\s+/g, " ").trim()
    const clipWords = (value, max) => {
      const words = value.trim().split(/\s+/).filter(Boolean)
      return words.length <= max ? value.trim() : `${words.slice(0, max).join(" ")}…`
    }
    const escape = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
    const marker = state.playing ? "⏸" : "▶"
    const identity = `${clipWords(sanitize(state.title), 6)} · ${clipWords(sanitize(state.artist), 4)}`
    const matches = [...text.matchAll(new RegExp(`${escape(marker)}\\s+\\S+\\s+${escape(identity)}`, "g"))]
    if (matches.length !== 1) throw new Error(`expected one coherent Pi status, found ${matches.length}`)
  ' || return 1
}
wait_pi_reload_ready() {
  local pane="$1" state="$2" message="$3" deadline=$((SECONDS+30)) recent normalized recent_rc attempt=0
  while test "$SECONDS" -lt "$deadline"; do
    attempt=$((attempt+1))
    if capture_ui "$pane"; then
      recent=''
      recent_rc=0
      recent="$(herdr pane read "$pane" --source recent-unwrapped --format text)" || recent_rc=$?
      normalized="$(printf '%s\n%s\n' "$UI_TEXT" "$recent" | tr '\n' ' ' | tr -s '[:space:]' ' ')"
      if test "$recent_rc" -eq 0 && grep -Fq -- "$message" <<<"$normalized" &&
         pi_output_has_state "$UI_TEXT" "$state"; then
        printf '%s pi-reload-ready attempt=%s message=%s\nvisible:\n%s\nrecent:\n%s\n' \
          "$(date -u +%FT%TZ)" "$attempt" "$message" "$UI_TEXT" "$recent" || return 1
        return 0
      fi
      printf '%s pi-reload-poll attempt=%s recent-status=%s ready=false\n' \
        "$(date -u +%FT%TZ)" "$attempt" "$recent_rc" >&2
    else
      printf '%s pi-reload-poll attempt=%s capture-status=failed ready=false\n' \
        "$(date -u +%FT%TZ)" "$attempt" >&2
    fi
    sleep 0.25 || return 1
  done
  return 1
}
select_oc_palette_action() {
  local pane="$1" query="$2" group="$3" title="$4"
  # Recovery invokes this helper as an `if` condition, which suppresses Bash
  # errexit throughout the function. Propagate every operation and assertion
  # explicitly so Enter can only follow a complete selected-row proof.
  herdr pane send-keys "$pane" escape >/dev/null || return 1
  sleep 0.1 || return 1
  herdr pane send-keys "$pane" ctrl+p >/dev/null || return 1
  herdr pane wait-output "$pane" --match 'Commands' --source visible --timeout 10000 >/dev/null || return 1
  herdr pane send-text "$pane" "$query" >/dev/null || return 1
  herdr pane wait-output "$pane" --match "$title" --source visible --timeout 10000 >/dev/null || return 1
  sleep 0.3 || return 1
  capture_ui "$pane" || return 1
  grep -Fq -- "$query" <<<"$UI_TEXT" || return 1
  PALETTE_ANSI="$UI_ANSI" PALETTE_TITLE="$title" PALETTE_GROUP="$group" bun -e '
    const ansi = process.env.PALETTE_ANSI ?? ""
    const title = process.env.PALETTE_TITLE ?? ""
    const group = process.env.PALETTE_GROUP ?? ""
    const strip = (s) => s.replace(/\x1b\[[0-?]*[ -\/]*[@-~]/g, "")
    const boldAtTitle = (line) => {
      const index = line.indexOf(title)
      if (index < 0) return false
      let bold = false
      for (const match of line.slice(0, index).matchAll(/\x1b\[([0-9;]*)m/g)) {
        const params = match[1] === "" ? [0] : match[1].split(";").map(Number)
        for (const value of params) {
          if (value === 0 || value === 22) bold = false
          if (value === 1) bold = true
        }
      }
      return bold
    }
    const candidates = ansi.split("\n").filter((line) => {
      const plain = strip(line)
      return plain.includes(title) && plain.includes(group)
    })
    const selected = candidates.filter(boldAtTitle)
    if (selected.length !== 1) {
      throw new Error(`expected one visibly bold selected ${group} / ${title} row; candidates=${candidates.length} selected=${selected.length}`)
    }
    console.log(`selected palette row: ${strip(selected[0]).trim()}`)
  ' || return 1
  printf '%s palette-query=%s selected=%s/%s\n%s\n' \
    "$(date -u +%FT%TZ)" "$query" "$group" "$title" "$UI_ANSI" || return 1
  return 0
}
validate_owned_root() {
  local root="$1" prefix="$2" owner parent processes
  printf '%s cleanup-root-inspection-command=test -d %q\n' "$(date -u +%FT%TZ)" "$root" || return 1
  printf '%s cleanup-root-inspection-command=test ! -L %q\n' "$(date -u +%FT%TZ)" "$root" || return 1
  printf "%s cleanup-root-inspection-command=stat -f '%%u' %q\n" "$(date -u +%FT%TZ)" "$root" || return 1
  printf '%s cleanup-root-inspection-command=realpath %q\n' "$(date -u +%FT%TZ)" "$(dirname "$root")" || return 1
  printf '%s cleanup-root-inspection-command=ps -axww -o command=; reject exact root reference %q\n' \
    "$(date -u +%FT%TZ)" "$root" || return 1
  test -d "$root" || return 1
  test ! -L "$root" || return 1
  owner="$(stat -f '%u' "$root")" || return 1
  test "$owner" = "$(id -u)" || return 1
  parent="$(realpath "$(dirname "$root")")" || return 1
  test "$parent" = "$tmp_base" || return 1
  case "$(basename "$root")" in "$prefix".*) ;; *) return 1 ;; esac
  processes="$(ps -axww -o command=)" || return 1
  ! grep -Fq -- "$root" <<<"$processes" || return 1
  printf '%s cleanup-root-validated=%s owner=%s parent=%s\n' \
    "$(date -u +%FT%TZ)" "$root" "$owner" "$parent" || return 1
}
cleanup_owned_root() {
  local root="$1" prefix="$2"
  validate_owned_root "$root" "$prefix" || return 1
  printf '%s cleanup-root=%s command=find %q -depth -delete\n' \
    "$(date -u +%FT%TZ)" "$root" "$root" || return 1
  find "$root" -depth -delete || return 1
  test ! -e "$root" || return 1
  printf '%s cleanup-root-absent=%s\n' "$(date -u +%FT%TZ)" "$root" || return 1
}

# Return 1 means the fixed P1-C2 source was uncontrollable but remained byte-identical;
# the bare caller still fails closed and never selects a replacement. Return 2 means
# command, restoration, identity, or boundary evidence failed.
# The desired idempotent restore command is saved before the first toggle. No
# unknown post-toggle path returns before that restoration has been attempted.
certify_media_candidate() {
  local label="$1" original playing opposite restore_command
  local toggle_rc=0 boundary_rc=0 observed='' current='' restore_rc=0 restored=''
  original="$(media_snapshot)" || return 2
  assert_live_music_app "$original" || return 2
  playing="$(jq -r .playing <<<"$original")"
  if test "$playing" = true; then
    opposite=false
    restore_command=play
  else
    opposite=true
    restore_command=pause
  fi
  printf '%s candidate-source=%s original=%s restore-command=%s\n' \
    "$(date -u +%FT%TZ)" "$label" "$original" "$restore_command"
  checkpoint pre-media-control-candidate-toggle 0 0 || return 2
  media-control toggle-play-pause || toggle_rc=$?
  checkpoint post-media-control-candidate-toggle 0 0 || boundary_rc=1

  # Prefer the already-observed opposite snapshot. Bounded re-observation then
  # distinguishes exact-original from a changed identity. Unavailable metadata
  # is represented by an empty current value and still enters restoration.
  if observed="$(wait_media_state "$original" "$opposite")"; then
    current="$observed"
  elif current="$(observe_candidate_state "$original")"; then
    :
  else
    current=''
    printf '%s candidate-state-unknown-after-toggle source=%s original=%s toggle_rc=%s; attempting-idempotent-restore=%s\n' \
      "$(date -u +%FT%TZ)" "$label" "$original" "$toggle_rc" "$restore_command" >&2
  fi

  # The byte-identical original proves no restoration is needed, but the fixed
  # P1-C2 run still returns failure rather than selecting a replacement.
  if test -n "$current" && test "$current" = "$original"; then
    printf '%s candidate-uncontrollable-but-unchanged source=%s toggle_rc=%s boundary_rc=%s state=%s\n' \
      "$(date -u +%FT%TZ)" "$label" "$toggle_rc" "$boundary_rc" "$current"
    test "$boundary_rc" -eq 0 || return 2
    test "$toggle_rc" -eq 0 || return 2
    return 1
  fi

  # Never issue a restore command against a positively identified different
  # item. Preserve both identities and stop for operator recovery instead.
  if test -n "$current" && ! same_identity "$original" "$current"; then
    printf '%s candidate-identity-changed source=%s original=%s current=%s; no command sent to different item\n' \
      "$(date -u +%FT%TZ)" "$label" "$original" "$current" >&2
    return 2
  fi

  # This covers both a proven opposite transition and unavailable metadata.
  # play/pause is idempotent, so the saved command is safe even if the first
  # toggle reported failure or its resulting state could not be sampled.
  checkpoint pre-media-control-candidate-restore 0 0 || boundary_rc=1
  media-control "$restore_command" || restore_rc=$?
  checkpoint post-media-control-candidate-restore 0 0 || boundary_rc=1
  if restored="$(wait_media_state "$original" "$playing")"; then :; else restored=''; fi
  if test -z "$restored" || test "$restored" != "$original"; then
    printf '%s candidate-restoration-unproven source=%s original=%s observed=%s restored=%s restore-command=%s restore-rc=%s\n' \
      "$(date -u +%FT%TZ)" "$label" "$original" "$current" "$restored" \
      "$restore_command" "$restore_rc" >&2
    return 2
  fi
  printf '%s candidate-restored source=%s toggle-rc=%s restore-command=%s restore-rc=%s boundary-rc=%s original=%s observed=%s restored=%s\n' \
    "$(date -u +%FT%TZ)" "$label" "$toggle_rc" "$restore_command" \
    "$restore_rc" "$boundary_rc" "$original" "$current" "$restored"
  test "$boundary_rc" -eq 0 || return 2
  test "$toggle_rc" -eq 0 || return 2
  test "$restore_rc" -eq 0 || return 2
  test -n "$observed" || return 2
  chosen_original="$original"
  chosen_playing="$playing"
  chosen_opposite="$opposite"
  chosen_source="$label"
  return 0
}

# Concrete normal-exit/error recovery; never sends a signal. It captures the
# owned tab/panes/processes/groups/peers/UI before and after normal-exit attempts,
# and never closes a live or unclassified launched-host tab. Submission is
# tracked before process discovery.
restore_original_directly() {
  local current rc=0 restored
  test -n "$chosen_original" || return 0
  current="$(media_snapshot)" || return 1
  test "$current" = "$chosen_original" && return 0
  same_identity "$chosen_original" "$current" || return 1
  test "$(jq -r .playing <<<"$current")" = "$chosen_opposite" || return 1
  recovery_checkpoint recovery-pre-media-restore || rc=1
  if test "$chosen_playing" = true; then
    media-control play || rc=1
  else
    media-control pause || rc=1
  fi
  recovery_checkpoint recovery-post-media-restore || rc=1
  restored="$(wait_media_state "$chosen_original" "$chosen_playing")" || return 1
  test "$restored" = "$chosen_original" || return 1
  return "$rc"
}
recovery_probe() {
  local label="$1" output rc
  shift
  output="$("$@" 2>&1)"
  rc=$?
  printf '%s recovery-probe=%s status=%s output=%s\n' \
    "$(date -u +%FT%TZ)" "$label" "$rc" "$output" >&2
  return 0
}
recovery_checkpoint() {
  local label="$1" output rc
  output="$(checkpoint_live "$label" 2>&1)"
  rc=$?
  printf '%s recovery-checkpoint=%s status=%s output=%s\n' \
    "$(date -u +%FT%TZ)" "$label" "$rc" "$output" >&2
  return "$rc"
}
capture_recovery_state() {
  local label="$1" pane info info_rc pgid pgid_rc endpoint endpoint_rc
  printf '%s recovery-evidence=%s tab=%s oc-pane=%s pi-pane=%s oc-root=%s pi-root=%s oc-pgid=%s pi-pgid=%s oc-peer-pid=%s pi-peer-pid=%s oc-returned=%s pi-returned=%s\n' \
    "$(date -u +%FT%TZ)" "$label" "$tab_id" "$oc_pane" "$pi_pane" "$oc_root" "$pi_root" \
    "$oc_pgid" "$pi_pgid" "$oc_peer_pid" "$pi_peer_pid" "$oc_shell_returned" "$pi_shell_returned" >&2
  endpoint="$(assert_endpoint 2>&1)"
  endpoint_rc=$?
  printf '%s recovery-probe=%s.endpoint status=%s output=%s baseline=%s\n' \
    "$(date -u +%FT%TZ)" "$label" "$endpoint_rc" "$endpoint" "$baseline_socket" >&2
  if test "$endpoint_rc" -eq 0 && test -n "$baseline_socket" && test "$endpoint" = "$baseline_socket"; then
    recovery_probe "$label.generation" direct_generation "$baseline_socket"
  else
    printf '%s recovery-probe=%s.generation status=skipped reason=missing-or-mismatched-baseline-endpoint\n' \
      "$(date -u +%FT%TZ)" "$label" >&2
  fi
  recovery_probe "$label.peers" peer_inventory_once
  recovery_probe "$label.media" media_snapshot
  for pane in "$oc_pane" "$pi_pane"; do
    test -n "$pane" || continue
    recovery_probe "$label.$pane.get" herdr pane get "$pane"
    info="$(process_info "$pane" 2>&1)"
    info_rc=$?
    printf '%s recovery-probe=%s.%s.process-info status=%s output=%s\n' \
      "$(date -u +%FT%TZ)" "$label" "$pane" "$info_rc" "$info" >&2
    if test "$info_rc" -eq 0; then
      recovery_probe "$label.$pane.full-commands" foreground_commands "$info"
      pgid="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$info" 2>&1)"
      pgid_rc=$?
      printf '%s recovery-probe=%s.%s.pgid status=%s output=%s\n' \
        "$(date -u +%FT%TZ)" "$label" "$pane" "$pgid_rc" "$pgid" >&2
      if test "$pgid_rc" -eq 0; then
        recovery_probe "$label.$pane.group" process_group_inventory "$pgid"
      fi
    fi
    recovery_probe "$label.$pane.ui-text" herdr pane read "$pane" --source visible --format text
    recovery_probe "$label.$pane.ui-ansi" herdr pane read "$pane" --source visible --format ansi
  done
}
recover_owned_run() {
  local original_rc="$1" info foreground row current
  trap - ERR
  set +e
  printf '%s recovery-start rc=%s oc_live=%s pi_live=%s oc_submitted=%s pi_submitted=%s\n' \
    "$(date -u +%FT%TZ)" "$original_rc" "$oc_live" "$pi_live" "$oc_submitted" "$pi_submitted" >&2
  capture_recovery_state before-normal-exit-attempts

  # A submitted-but-unclassified launch is inspected once. It becomes eligible
  # for normal exit only after a real non-shell PGID and foreground set exist.
  if test "$pi_submitted" -eq 1 && test "$pi_live" -eq 0 && test -n "$pi_pane"; then
    if test "$pi_shell_returned" -eq 1; then
      current="$(peer_inventory_once)"
      if test -n "$pi_peer_pid" && assert_peer_pid_absent "$current" "$pi_peer_pid" &&
         recovery_checkpoint recovery-post-pi-returned; then
        pi_submitted=0
      else
        printf '%s recovery-pi-returned-but-peer-not-proven-absent; leaving pane/root/tab\n' "$(date -u +%FT%TZ)" >&2
      fi
    else
      info="$(process_info "$pi_pane")"
      foreground="$(jq -er '.result.process_info.foreground_process_group_id' <<<"$info")"
      if test "$foreground" != "$pi_shell_pid" && test -n "$(foreground_commands "$info")"; then
        pi_pgid="$foreground"
        pi_live=1
      else
