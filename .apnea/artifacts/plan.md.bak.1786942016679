      recovery_checkpoint recovery-pre-opencode-exit
      herdr pane send-keys "$oc_pane" enter >/dev/null
      if wait_shell_return "$oc_pane" "$oc_shell_pid" >/dev/null &&
         assert_recorded_pids_gone "$info" && assert_group_empty "$oc_pgid"; then
