{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "bun"
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.github/workflows/*.yml",
      "{workspaceRoot}/.gitattributes",
      "{workspaceRoot}/.editorconfig",
      "{workspaceRoot}/.prettierignore",
      "{workspaceRoot}/.prettierrc.json",
      { "runtime": "bun --version" },
      { "runtime": "node --version" }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "format:check": {
      "cache": true,
      "inputs": ["default"]
    },
    "package:check": {
      "cache": true,
      "inputs": ["default", { "runtime": "npm --version" }]
    },
    "smoke": {
      "cache": true,
      "inputs": ["default", "^default", { "runtime": "npm --version" }]
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "groups": {
      "apnea": {
        "projects": ["apnea"]
      },
      "music-core": {
        "projects": ["music-core"]
      },
      "opencode-music-player": {
        "projects": ["opencode-music-player"]
      },
      "opencode-vim": {
        "projects": ["opencode-vim"]
      },
      "pi-apnea": {
        "projects": ["pi-apnea"]
      },
      "pi-music-dock": {
        "projects": ["pi-music-dock"]
      }
    },
    "version": {
      "useLegacyVersioning": false,
      "preVersionCommand": "bun run security:check && bun run policy:check && bunx nx run-many -t typecheck test parity format:check package:check && bunx nx run-many -t smoke --parallel=1",
      "conventionalCommits": true,
      "updateDependents": "auto",
      "fallbackCurrentVersionResolver": "disk",
      "manifestRootsToUpdate": ["{projectRoot}"]
    },
    "git": {
      "commit": true,
      "commitArgs": "--no-verify",
      "push": true
    },
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github",
        "file": false
      },
      "workspaceChangelog": false,
      "commitMessageFormat": "conventional"
    },
    "conventionalCommits": {
      "docs": {
        "semverBump": "patch"
      }
    },
    "releaseTag": {
      "pattern": "{projectName}@v{version}"
    }
  },
  "analytics": false
}
