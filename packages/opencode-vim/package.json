{
  "name": "@naxodev/opencode-vim",
  "version": "0.1.2",
  "description": "Native Vim-style modal prompt editing for the OpenCode 2 TUI",
  "license": "MIT",
  "author": {
    "name": "Nacho Vazquez",
    "url": "https://github.com/NachoVazquez"
  },
  "funding": "https://github.com/sponsors/NachoVazquez",
  "homepage": "https://github.com/naxodev/ai/tree/main/packages/opencode-vim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naxodev/ai.git",
    "directory": "packages/opencode-vim"
  },
  "bugs": {
    "url": "https://github.com/naxodev/ai/issues"
  },
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "vim",
    "modal-editing"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.vimcode",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "test": "bun test tests/clipboard.test.ts tests/editor-actions.test.ts tests/engine.test.ts tests/ex-command.test.ts tests/host-keymap.test.ts tests/package-load.test.ts tests/plugin-lifecycle.test.tsx",
    "test:parity": "bun test tests/parity.test.ts",
    "pack:check": "bun run scripts/verify-pack.ts",
    "smoke:package": "bun run scripts/package-smoke.ts",
    "validate": "bun run format:check && bun run check && bun run test && bun run test:parity && bun run pack:check && bun run smoke:package"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.3",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.3",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "solid-js": "1.9.15",
    "@opencode/theme": "2.0.3",
    "@types/bun": "^1.3.14",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  }
}
