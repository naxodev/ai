{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "opencode-vim",
  "projectType": "library",
  "sourceRoot": "packages/opencode-vim",
  "tags": ["scope:public", "type:package"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run check",
        "cwd": "packages/opencode-vim"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test",
        "cwd": "packages/opencode-vim"
      }
    },
    "parity": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run test:parity",
        "cwd": "packages/opencode-vim"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run format:check",
        "cwd": "packages/opencode-vim"
      }
    },
    "package:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run pack:check",
        "cwd": "packages/opencode-vim"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run smoke:package",
        "cwd": "packages/opencode-vim"
      }
    }
  }
}
