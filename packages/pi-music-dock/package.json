{
  "name": "@naxodev/pi-music-dock",
  "version": "0.1.0",
  "description": "Pi status-line dock for macOS system Now Playing (media-control)",
  "license": "MIT",
  "author": "Nacho Vazquez",
  "funding": "https://github.com/sponsors/NachoVazquez",
  "homepage": "https://github.com/naxodev/ai/tree/main/packages/pi-music-dock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naxodev/ai.git",
    "directory": "packages/pi-music-dock"
  },
  "bugs": {
    "url": "https://github.com/naxodev/ai/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "macos",
    "now-playing",
    "media-control",
    "statusline"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "extensions",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.7",
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run test && bun run format:check && bun run pack:check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run",
    "smoke:package": "bun scripts/package-smoke.ts"
  },
  "dependencies": {
    "@naxodev/music-core": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0 <0.85.0",
    "@earendil-works/pi-tui": ">=0.83.0 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.0",
    "typescript": "^7.0.2"
  }
}
