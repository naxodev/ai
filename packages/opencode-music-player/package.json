{
  "name": "@naxodev/opencode-music-player",
  "version": "0.2.6",
  "description": "macOS system Now Playing controls for the OpenCode 2 TUI",
  "license": "MIT",
  "author": {
    "name": "Nacho Vazquez",
    "url": "https://github.com/NachoVazquez"
  },
  "funding": "https://github.com/sponsors/NachoVazquez",
  "homepage": "https://github.com/naxodev/ai/tree/main/packages/opencode-music-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naxodev/ai.git",
    "directory": "packages/opencode-music-player"
  },
  "bugs": {
    "url": "https://github.com/naxodev/ai/issues"
  },
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "macos",
    "now-playing",
    "media-control"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "SUPPORT.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload",
    "pack:check": "bun run ../../scripts/music-release.ts opencode-music-player --staged-only && bun run scripts/verify-pack.ts",
    "prepublish:core": "bun run ../../scripts/music-release.ts opencode-music-player",
    "smoke:package": "bun run scripts/package-smoke.ts",
    "validate": "bun run format:check && bun run check && bun run test && bun run pack:check"
  },
  "dependencies": {
    "@naxodev/music-core": "^0.1.4",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.3",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.3",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "solid-js": "1.9.15",
    "@opencode/theme": "2.0.3",
    "@types/bun": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  }
}
