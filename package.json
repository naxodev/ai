{
  "name": "@naxodev/ai",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "7.29.7",
    "@opentelemetry/core": "2.8.0",
    "brace-expansion": "5.0.9",
    "smol-toml": "1.8.0"
  },
  "scripts": {
    "check": "bun run compatibility:check && bun run format:check && bun run security:check && bun run policy:check && bunx nx run-many -t lint typecheck test parity format:check package:check && bunx nx run-many -t smoke --parallel=1 && bun run security:consumers && bun run compatibility:minimum-bun",
    "lint": "bun run scripts/async-lint.ts",
    "compatibility:minimum-bun": "bun run scripts/minimum-bun.ts",
    "compatibility:check": "bun run scripts/opencode-compatibility.ts && bun run scripts/compatibility-docs.ts",
    "compatibility:docs:write": "bun run scripts/compatibility-docs.ts --write",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:dry-run": "bunx nx release --skip-publish --dry-run",
    "policy:check": "bun test scripts",
    "security:check": "bun audit",
    "security:consumers": "bun run scripts/opencode-consumer-audit.ts"
  },
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@types/bun": "^1.4.2",
    "nx": "23.2.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "minimatch@8.0.7": "patches/minimatch@8.0.7.patch",
    "minimatch@9.0.9": "patches/minimatch@9.0.9.patch"
  }
}
