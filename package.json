{
  "name": "@naxodev/ai",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run format:check && bun run policy:check && bunx nx run-many -t typecheck test parity format:check package:check smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:dry-run": "bunx nx release --skip-publish --dry-run",
    "policy:check": "bun test scripts"
  },
  "devDependencies": {
    "@nx/js": "23.1.1",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
